---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/erdeklodes.css';
---
<Layout title="Érdeklődés - Mesejó világ" activeNav="kapcsolat" bodyBg="sky">
  <Fragment slot="bodystart">
    <div id="fb-root"></div>
    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/hu_HU/sdk.js#xfbml=1&version=v23.0"></script>
  </Fragment>

  <main class="main-content">
    <div class="content-wrapper">
      <h1 class="page-title">Érdeklődés</h1>

      <div class="call-section">
        <h2>📞 Hívj bizalommal!</h2>
        <p>Kérdésed van? Beszéljünk személyesen!</p>
        <a href="tel:+36301234567" class="phone-number">+36 70 450 1677</a>
      </div>

      <div id="successMessage" class="success-message">
        Sajnos üzenetküldő szolgáltatásunk még nem üzemel, kérjük, keress telefonon vagy Facebook-üzenetben!
      </div>

      <div class="form-section">
        <form action="https://formcarry.com/s/9CLuc27gM8C" method="POST" enctype="multipart/form-data" id="contactForm">
          <div class="row">
            <div class="col-md-6">
              <label for="name" class="form-label">Név <span class="required">*</span></label>
              <input type="text" class="form-control" id="name" name="name" placeholder="Add meg a neved" required />
              <div id="nameError" class="error-message"></div>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">E-mail cím <span class="required">*</span></label>
              <input type="email" class="form-control" id="email" name="email" placeholder="pelda@email.hu" required />
              <div id="emailError" class="error-message"></div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <label for="phone" class="form-label">Telefonszám</label>
              <input type="tel" class="form-control" id="phone" name="phone" placeholder="+36 30 123 4567" />
              <div id="phoneError" class="error-message"></div>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label section-title">Melyik foglalkozás érdekel?</label>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="mesejo" id="mesejo" name="activities" />
              <label class="form-check-label" for="mesejo">Mesejó foglalkozások</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="yoga" id="yoga" name="activities" />
              <label class="form-check-label" for="yoga">Gyerekjóga</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="meseerdo" id="walks" name="activities" />
              <label class="form-check-label" for="walks">MeseErdő séták</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="rajzelemzes" id="selfknowledge" name="activities" />
              <label class="form-check-label" for="selfknowledge">Rajzelemzés</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="coaching" id="coaching" name="activities" />
              <label class="form-check-label" for="coaching">Life coaching</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="lelkipiheno" id="lp" name="activities" />
              <label class="form-check-label" for="lp">Mesejó Lelki Pihenő</label>
            </div>
          </div>

          <div class="mb-4">
            <label for="message" class="form-label section-title">Kérdések, megjegyzések:</label>
            <textarea class="form-control" id="message" name="message" rows="5" placeholder="Írd ide kérdéseid, megjegyzéseid..."></textarea>
          </div>
          <input type="checkbox" id="consent" required />
          <label for="consent" class="form-check-label">
            Elolvastam és elfogadom az <a href="/doc/mesejo_akt.pdf" target="_blank">Adatkezelési tájékoztatót</a>.
          </label>
          <button type="submit" class="submit-btn">Üzenet küldése</button>
        </form>
      </div>

      <div
        class="fb-page"
        data-href="https://www.facebook.com/profile.php?id=61552436930107"
        data-tabs="timeline"
        data-width=""
        data-height=""
        data-small-header="false"
        data-adapt-container-width="true"
        data-hide-cover="false"
        data-show-facepile="true"
      >
        <blockquote cite="https://www.facebook.com/profile.php?id=61552436930107" class="fb-xfbml-parse-ignore">
          <a href="https://www.facebook.com/profile.php?id=61552436930107">Mesejó világ</a>
        </blockquote>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script>
      import '../scripts/contact-form.js';
    </script>
  </Fragment>
</Layout>
