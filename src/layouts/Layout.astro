---
// This one file replaces the header + desktop nav + mobile menu + footer
// markup that used to be copy-pasted, by hand, into all 8 HTML pages.
// Every page just wraps its own content in <Layout ...>...</Layout> now.
//
// While merging the 8 copies of this markup, a few small inconsistencies
// turned up between pages (different pages behaved slightly differently on
// scroll, in the mobile menu, etc.) — those are called out inline below,
// and summarized in the chat response.
//
// FOUND DURING MERGE: the logo linked home on most pages, but was a plain,
// unlinked image on Főoldal and Aktuális. It always links home now.

import '../styles/global.css';

export interface Props {
  /** Browser tab title */
  title: string;
  /** Which nav item to mark as the current page */
  activeNav: 'fooldal' | 'gyerekeknek' | 'felnotteknek' | 'aktualis' | 'ajandekutalvany' | 'naptar' | 'rolam' | 'kapcsolat';
  /**
   * Fallback body background color shown briefly before /img/mjv.png loads.
   * Kapcsolat, Felnőtteknek and Gyerekeknek originally used sky blue; every
   * other page used cream. See the --body-bg-fallback variable in global.css.
   */
  bodyBg?: 'cream' | 'sky';
}

const { title, activeNav, bodyBg = 'cream' } = Astro.props;

const isDropdownActive = activeNav === 'gyerekeknek' || activeNav === 'felnotteknek';

// One row per nav item: [key, label, path]. Rendered twice below (desktop +
// mobile) so the two menus can never drift out of sync with each other again.
const NAV_ITEMS: Array<[Props['activeNav'], string, string]> = [
  ['fooldal', 'Főoldal', '/'],
  ['aktualis', 'Aktuális', '/aktualis'],
  ['ajandekutalvany', 'Ajándékutalvány', '/ajandekutalvany'],
  // FOUND DURING MERGE: only index.html and naptar.html linked to the
  // calendar — every other page's nav was missing it, so there was no way
  // to reach Naptár except from the homepage or a direct link. Included
  // everywhere now.
  ['naptar', 'Naptár', '/naptar'],
  ['rolam', 'Rólam', '/rolam'],
  ['kapcsolat', 'Kapcsolat', '/erdeklodes'],
];

// The mobile menu has no dropdown — it always shows Gyerekeknek and
// Felnőtteknek as their own flat links, right after Főoldal.
const MOBILE_NAV_ITEMS: Array<[Props['activeNav'], string, string]> = [
  NAV_ITEMS[0],
  ['gyerekeknek', 'Gyerekeknek', '/gyerekeknek'],
  ['felnotteknek', 'Felnőtteknek', '/felnotteknek'],
  ...NAV_ITEMS.slice(1),
];
---

<!DOCTYPE html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body style={bodyBg === 'sky' ? '--body-bg-fallback: #87CEEB;' : undefined}>
    <slot name="bodystart" />
    <header class="header">
      <div class="logo-container">
        <a href="/">
          <img src="/img/image.png" alt="Mesejó világ Logo" class="logo" />
        </a>
      </div>
    </header>

    <nav class="navbar-custom">
      <div class="nav-links">
        <a
          href={activeNav === 'fooldal' ? '#' : '/'}
          class={`nav-btn${activeNav === 'fooldal' ? ' active' : ''}`}
        >Főoldal</a>

        <div class="dropdown nav-item">
          <a href="#" class={`nav-btn dropdown-btn${isDropdownActive ? ' active' : ''}`}>Foglalkozások</a>
          <div class="dropdown-content">
            <a href={activeNav === 'gyerekeknek' ? '#' : '/gyerekeknek'} class="nav-btn">Gyerekeknek</a>
            <a href={activeNav === 'felnotteknek' ? '#' : '/felnotteknek'} class="nav-btn">Felnőtteknek</a>
          </div>
        </div>

        {NAV_ITEMS.filter(([key]) => key !== 'fooldal').map(([key, label, href]) => (
          <a
            href={activeNav === key ? '#' : href}
            class={`nav-btn${activeNav === key ? ' active' : ''}`}
          >{label}</a>
        ))}
      </div>
    </nav>

    <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">☰</button>

    <div class="mobile-nav-menu" id="mobileNavMenu">
      <button class="close-menu" onclick="toggleMobileMenu()">×</button>
      {/* The mobile menu flattens the "Foglalkozások" dropdown into two
          plain links, shown on every page (same as the original markup). */}
      {MOBILE_NAV_ITEMS.map(([key, label, href]) => (
        <a
          href={activeNav === key ? '#' : href}
          class={`nav-btn${activeNav === key ? ' active' : ''}`}
          onclick="toggleMobileMenu()"
        >{label}</a>
      ))}
    </div>

    <slot />

    <footer class="footer">
      <div class="footer-content">
        <nav>
          <ul class="footer-links">
            <li><a href="/doc/mesejo_impresszum.pdf" class="footer-link" target="_blank">Impresszum</a></li>
            <li class="footer-separator">•</li>
            <li><a href="/doc/mesejo_akt.pdf" class="footer-link" target="_blank">Adatkezelési tájékoztató</a></li>
          </ul>
        </nav>
        <div class="footer-divider"></div>
        <p class="footer-copyright">© 2025 Mesejó világ. Minden jog fenntartva.</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      import '../scripts/nav.js';
    </script>
    <slot name="scripts" />
  </body>
</html>
